# ==========================================
# VoxScribe AI - Environment Configuration
# ==========================================

# Backend Configuration (voxscribe-backend/.env)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
GROQ_API_KEY=gsk_your_groq_api_key
HUGGINGFACE_API_KEY=hf_your_huggingface_api_token   # only needed if EMBEDDINGS_PROVIDER=huggingface

# Optional backend settings
# Embeddings: "local" (free, runs on your CPU) or "huggingface" (Inference API, needs credits)
EMBEDDINGS_PROVIDER=local
# Groq models users can pick from (first = default)
AVAILABLE_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
# Max generations per user per 24 hours (0 = unlimited)
DAILY_GENERATION_LIMIT=25
# Transcribe caption-less YouTube videos with yt-dlp + Groq Whisper
ENABLE_WHISPER_FALLBACK=true
# Comma-separated allowed origins; leave empty to allow any origin (development only)
CORS_ORIGINS=http://localhost:3000

# Frontend Configuration (voxscribe-app/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_API_URL=http://localhost:8000
